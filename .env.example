# Server Environment
NODE_ENV=production
PORT=3000
SITE_URL=https://www.pracharprasar.co
SITE_NAME="Prachar Prasar"
CONTACT_EMAIL=contact@pracharprasar.co
CONTACT_PHONE="+91 9682809232"

# Formspree Lead Notifications
FORMSPREE_FORM_ID=mzedgegb
FORMSPREE_ENDPOINT=https://formspree.io/f/mzedgegb

# Notification / Transactional Email (Optional SMTP setup)
SMTP_HOST=smtp.pracharprasar.co
SMTP_PORT=587
SMTP_USER=contact@pracharprasar.co
SMTP_PASS=your-smtp-password-placeholder
EMAIL_FROM="Prachar Prasar Inquiries <contact@pracharprasar.co>"
LEAD_NOTIFICATION_EMAIL=contact@pracharprasar.co

# Durable Storage (File-based JSON adapter active by default; set DATABASE_URL for PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/pracharprasar_leads

# Analytics & Pixels (Optional)
GA_MEASUREMENT_ID=
META_PIXEL_ID=

# AI Studio injected variables
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
